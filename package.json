{
  "name": "lightaudit",
  "version": "0.1.0",
  "private": true,
  "description": "LightAudit Score — Local-first Lighthouse auditing desktop app",
  "author": {
    "name": "LightAudit",
    "email": "simon@crawlforge.dev"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "rebuild:node": "npm rebuild better-sqlite3",
    "pretest": "npm rebuild better-sqlite3 >/dev/null 2>&1 || true",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/alias-hooks.mjs scripts/audit-cli.ts",
    "start:next": "next start"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "ai": "^7.0.90",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.8.0",
    "lighthouse": "^13.3.0",
    "lucide-react": "^1.16.0",
    "nanoid": "^5.1.11",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "p-queue": "^9.3.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.60.0",
    "shadcn": "^4.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
